        examples=["focus", "decision clarity", "planning horizon"],
    ),
    MasterDimension(
        key="affective",
        name="Emotional and Affective States",
        description="Mood, stress, resilience, and emotional volatility.",
        examples=["stress", "morale", "affective stability"],
