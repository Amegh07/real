"""
Missing Feature Registry — Final Sections AF-AY
===============================================
Missing features from the original specification that need to be added.
"""

from dataclasses import dataclass, field
from typing import List
from enum import Enum, auto


class MissingSystem(Enum):
    NUTRITIONAL_EXTENDED = auto()
    IMMUNOLOGICAL_EXTENDED = auto()
    NEUROLOGICAL_EXTENDED = auto()
    ENDOCRINE_EXTENDED = auto()
    SLEEP_EXTENDED = auto()
    PAIN_SYSTEM = auto()
    DEATH_SYSTEM = auto()
    HERITAGE_SYSTEM = auto()
    DIPLOMATIC_EXTENDED = auto()
    INTELLIGENCE_SYSTEM = auto()
    PROPAGANDA_SYSTEM = auto()
    TRADE_SYSTEM = auto()
    CURRENCY_SYSTEM = auto()
    LABOR_SYSTEM = auto()
    HOUSING_SYSTEM = auto()
    MEDICINE_EXTENDED = auto()
    MUSIC_SYSTEM = auto()
    SMELL_SYSTEM = auto()
    ARCHITECTURAL_EXTENDED = auto()


@dataclass
class MissingFeature:
    feature_id: str
    feature_name: str
    system: MissingSystem
    normal_range: tuple
    unit: str
    description: str
    measurement: str
    tags: List[str] = field(default_factory=list)


MISSING_FEATURES: dict = {}


