    friend_count: int = 0
    rival_count:  int = 0
    dimension_state: Dict[str, dict] = field(default_factory=dict)
    
    # ── Section E: Financial System Integration ─────────────────
    portfolio_value: float = 0.0
    asset_holdings: Dict[str, float] = field(default_factory=dict)
    debt: float = 0.0
