        """Generate energy compatible stat (0-100)."""
        # Based on metabolic state
        e = 50 + (self.energy_available / 50) * 50
        # Sleep debt penalty
        e -= self.sleep_debt * 2
        # Autonomic state
        if self.autonomic_state == "sympathetic":
