"""
Feature registry for generated and hand-authored simulation features.

This keeps the ontology grounded in concrete, inspectable feature specs.
"""

from __future__ import annotations

import json
from dataclasses import asdict, dataclass, field
from pathlib import Path
from typing import List, Optional

try:
    from ontology.extended_features import EXTENDED_FEATURES
except ImportError:
    EXTENDED_FEATURES = []


REGISTRY_PATH = Path(__file__).resolve().parent.parent / "data" / "feature_registry.json"


@dataclass
class FeatureSpec:
    feature_id: str
    feature_name: str
    domain: str
    scale: str
    timescale: str
    observability: str
    reversibility: str
    emergence_class: str
    mechanism: str
