    # ── Section C2: HEXACO ────────────────────────────────
    honesty_humility: float = 0.6       # Sincerity, fairness

    # ── Section C2: Attachment & Behavioral Systems ────
    attachment_anxiety: float = 0.3    # Fear of abandonment
