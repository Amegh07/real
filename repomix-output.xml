    # ── Section C2: Locus of Control ────────────────────────
    locus_of_control: float = 0.5           # 0=external, 1=internal

    # ── Section D1: Kinship & Family ────────────────────────
    genetic_relatedness: float = 0.0      # r coefficient for relations
