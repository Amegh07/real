}
.btn:disabled { opacity: 0.4; cursor: not-allowed; }
.btn-green  { background: var(--accent-green);  color: #000; }
.btn-green:hover:not(:disabled)  { background: #0ea572; box-shadow: 0 0 16px rgba(16,185,129,0.4); }
.btn-red    { background: var(--accent-red);    color: #fff; }
.btn-red:hover:not(:disabled)    { background: #dc2626; box-shadow: 0 0 16px rgba(239,68,68,0.4); }
.btn-ghost  { background: var(--bg-input);      color: var(--text-muted); border: 1px solid var(--border-subtle); }
.btn-ghost:hover:not(:disabled)  { color: var(--text-main); border-color: var(--border-dim); }

/* ── Scrollbar ──────────────────────────────────────────── */
::-webkit-scrollbar       { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border-dim); border-radius: 3px; }

/* ── Divider ────────────────────────────────────────────── */
