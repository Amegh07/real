@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

/* ── Design Tokens ──────────────────────────────────────── */
:root {
  --bg-dark:          #060d1a;
  --bg-deep:          #04080f;
  --bg-card:          rgba(14, 28, 54, 0.55);
  --bg-card-hover:    rgba(20, 40, 75, 0.7);
  --bg-modal:         rgba(6, 13, 26, 0.97);
  --bg-input:         rgba(255,255,255,0.05);

  --border-subtle:    rgba(255, 255, 255, 0.07);
  --border-dim:       rgba(255, 255, 255, 0.12);
  --border-glow-blue: rgba(59, 130, 246, 0.45);
  --border-glow-purple: rgba(139, 92, 246, 0.4);

  --text-main:        #e8f0fe;
  --text-muted:       #5a7299;
  --text-dim:         #3a5278;

  --accent-blue:      #3b82f6;
  --accent-blue-dim:  rgba(59, 130, 246, 0.15);
  --accent-purple:    #8b5cf6;
  --accent-purple-dim:rgba(139, 92, 246, 0.15);
  --accent-green:     #10b981;
  --accent-green-dim: rgba(16, 185, 129, 0.15);
  --accent-red:       #ef4444;
  --accent-red-dim:   rgba(239, 68, 68, 0.15);
  --accent-yellow:    #f59e0b;
  --accent-yellow-dim:rgba(245, 158, 11, 0.15);
  --accent-cyan:      #06b6d4;
  --accent-cyan-dim:  rgba(6, 182, 212, 0.15);

  --font-body:        'Inter', sans-serif;
  --font-mono:        'JetBrains Mono', monospace;

  --radius-sm:        8px;
  --radius-md:        14px;
  --radius-lg:        20px;
  --radius-xl:        28px;

  --shadow-card:      0 8px 40px rgba(0,0,0,0.4);
  --shadow-glow-blue: 0 0 30px rgba(59,130,246,0.12);
  --shadow-glow-purple: 0 0 30px rgba(139,92,246,0.12);
}

/* ── Reset ──────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ── Body ───────────────────────────────────────────────── */
body {
  font-family: var(--font-body);
  background-color: var(--bg-dark);
  color: var(--text-main);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  background-image:
    radial-gradient(ellipse 80% 50% at 10% 20%,  rgba(59,130,246,0.07) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 90% 70%,  rgba(139,92,246,0.07) 0%, transparent 60%),
    radial-gradient(ellipse 50% 60% at 50% 100%, rgba(16,185,129,0.04) 0%, transparent 60%);
  background-attachment: fixed;
}

/* ── Layout ─────────────────────────────────────────────── */
.app-shell {
  max-width: 1560px;
  margin: 0 auto;
  padding: 1.5rem 2rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

/* ── Glass Panel ────────────────────────────────────────── */
.glass {
  background: var(--bg-card);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease;
}
.glass:hover {
  border-color: var(--border-dim);
  box-shadow: var(--shadow-card), var(--shadow-glow-blue);
}
.glass-clickable {
  cursor: pointer;
}
.glass-clickable:hover {
  border-color: var(--border-glow-blue);
  transform: translateY(-3px);
  box-shadow: var(--shadow-card), var(--shadow-glow-blue);
}

/* ── Navigation Tabs ───────────────────────────────────── */
.nav-tabs {
  display: flex;
  gap: 0.4rem;
  background: rgba(0,0,0,0.3);
  padding: 5px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle);
}
.tab-btn {
  padding: 0.5rem 1.2rem;
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--text-muted);
  font-family: var(--font-body);
  font-weight: 500;
  font-size: 0.88rem;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.tab-btn:hover { color: var(--text-main); background: rgba(255,255,255,0.05); }
.tab-btn.active {
  background: linear-gradient(135deg, var(--accent-blue-dim), var(--accent-purple-dim));
  color: var(--text-main);
  border: 1px solid var(--border-glow-blue);
  box-shadow: 0 2px 12px rgba(59,130,246,0.2);
}

/* ── Stat Grid ──────────────────────────────────────────── */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 1rem;
}

/* ── Dashboard Split ────────────────────────────────────── */
.dashboard-split {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 1.2rem;
}
@media (max-width: 1100px) {
  .dashboard-split { grid-template-columns: 1fr; }
}

/* ── Agent Grid ─────────────────────────────────────────── */
.agent-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: 1rem;
}

.dimension-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 0.9rem;
}

.dimension-card,
.feature-card,
.causal-card {
  padding: 0.95rem;
  background: rgba(0,0,0,0.22);
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
}

/* ── Typography ────────────────────────────────────────── */
h1 {
  font-weight: 800;
  font-size: 1.8rem;
  background: linear-gradient(135deg, #e8f0fe 0%, #7bb4fc 50%, #a78bfa 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: -0.03em;
}
h2 {
  font-weight: 600;
  font-size: 1.1rem;
  color: var(--text-main);
  letter-spacing: -0.01em;
}
h3 {
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.mono { font-family: var(--font-mono); }

/* ── Badges ─────────────────────────────────────────────── */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.2rem 0.6rem;
  border-radius: 20px;
  font-size: 0.72rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.badge-blue   { background: var(--accent-blue-dim);   color: var(--accent-blue);   border: 1px solid rgba(59,130,246,0.3); }
.badge-purple { background: var(--accent-purple-dim); color: var(--accent-purple); border: 1px solid rgba(139,92,246,0.3); }
.badge-green  { background: var(--accent-green-dim);  color: var(--accent-green);  border: 1px solid rgba(16,185,129,0.3); }
.badge-red    { background: var(--accent-red-dim);    color: var(--accent-red);    border: 1px solid rgba(239,68,68,0.3); }
.badge-yellow { background: var(--accent-yellow-dim); color: var(--accent-yellow); border: 1px solid rgba(245,158,11,0.3); }
.badge-cyan   { background: var(--accent-cyan-dim);   color: var(--accent-cyan);   border: 1px solid rgba(6,182,212,0.3); }

/* ── Progress Bars ──────────────────────────────────────── */
.progress-track {
  height: 5px;
  background: rgba(0,0,0,0.35);
  border-radius: 3px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 3px;
  transition: width 0.6s cubic-bezier(0.4,0,0.2,1);
}

/* ── Pulse animations ───────────────────────────────────── */
@keyframes pulse-ring {
  0%   { box-shadow: 0 0 0 0 rgba(239,68,68,0.4); }
  70%  { box-shadow: 0 0 0 8px rgba(239,68,68,0); }
  100% { box-shadow: 0 0 0 0 rgba(239,68,68,0); }
}
.pulse-critical { animation: pulse-ring 1.8s infinite; }

@keyframes dot-blink {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.3; }
}
.dot-live { animation: dot-blink 1.4s ease-in-out infinite; }

@keyframes fade-in-up {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
.fade-in-up { animation: fade-in-up 0.35s ease both; }

/* ── Modal ──────────────────────────────────────────────── */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(4,8,15,0.85);
  backdrop-filter: blur(8px);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000;
  padding: 1.5rem;
